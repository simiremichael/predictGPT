# ──────────────────────────────────────────────────────────────────────
# Football AI — environment configuration template
#
# Copy this file to `.env` and fill in real values before deploying.
# FastAPI Cloud injects production secrets via environment variables,
# so this template documents the available keys.
# ──────────────────────────────────────────────────────────────────────

# ── Active data provider ───────────────────────────────────────────────
FOOTBALL_DATA_PROVIDER=sportmonks

# ── API-Football ──────────────────────────────────────────────────────
# API_FOOTBALL_KEY=your_api_football_key
# API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# API_FOOTBALL_RATE_LIMIT=10

# ── Sportmonks ────────────────────────────────────────────────────────
SPORTMONKS_API_TOKEN=your_sportmonks_token
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football
SPORTMONKS_RATE_LIMIT=29

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/football_ai

# ── Redis ─�────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_DEFAULT=3600

# ── AI / LLM ──────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2

# ── Web Research ───────────────────────────────────────────────────────
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=your_tavily_key
WEB_SEARCH_BASE_URL=https://api.duckduckgo.com
RESEARCH_MAX_AGE_HOURS=24
SOURCE_CREDIBILITY_ENABLED=true

# ── Admin / API security ──────────────────────────────────────────────
ADMIN_API_KEY=predictK2ghqMOkHsgaa0leHUUsuuRHFOaQrKkN

# ── Auth / JWT ───────────────────────────────────────────────────────
SECRET_KEY=change_this_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
GMAIL_USERNAME=your-account@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
GMAIL_FROM_EMAIL=your-account@gmail.com

# ── Flutterwave ─────────────────────────────────────────────────────────
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret
FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key
FLUTTERWAVE_WEBHOOK_SECRET=your_flutterwave_webhook_secret
FLUTTERWAVE_PAYMENT_PLAN_ID=your_payment_plan_id
FLUTTERWAVE_CLIENT_ID=your_flutterwave_client_id
FLUTTERWAVE_CLIENT_SECRET=your_flutterwave_client_secret
FLUTTERWAVE_API_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_OAUTH_URL=https://idp.flutterwave.com/realms/flutterwave/protocol/openid-connect/token
SUBSCRIPTION_PRICE_USD=5.0
SUBSCRIPTION_PRICE_NGN=7000
NIGERIA_COUNTRY_CODE=NG

# ── Application ───────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO
TAVILY_API_KEY=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

FRONTEND_URL=https://football-ai.app

# ── CORS ────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:19006,https://football-ai.app
ALLOWED_HOSTS=*
