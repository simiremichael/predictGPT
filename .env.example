# Football AI environment template. Put live values in local .env files or Render secrets.

FOOTBALL_DATA_PROVIDER=sportmonks
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
SPORTMONKS_API_TOKEN=
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE?ssl=require
REDIS_URL=rediss://default:REDIS_PASSWORD@HOST:6379
REDIS_CACHE_TTL_DEFAULT=3600

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_ATTACK_IMPACT_CAP=0.15
AI_DEFENSE_IMPACT_CAP=0.15

WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=https://api.duckduckgo.com
RESEARCH_MAX_AGE_HOURS=24
SOURCE_CREDIBILITY_ENABLED=true

ADMIN_API_KEY=replace-with-a-strong-secret
CORS_ORIGINS=["http://localhost:3000","http://localhost:19006"]
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO

# Web and mobile API endpoints
NEXT_PUBLIC_API_URL=https://predictgpt.onrender.com
NEXT_PUBLIC_API_FALLBACK_URL=http://localhost:8000
FRONTEND_URL=https://football-ai.app
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
FLUTTERWAVE_PAYMENT_PLAN_ID=
SUBSCRIPTION_PRICE_USD=5.00
EXPO_PUBLIC_API_URL=https://predictgpt.onrender.com
EXPO_PUBLIC_API_FALLBACK_URL=http://localhost:8000
